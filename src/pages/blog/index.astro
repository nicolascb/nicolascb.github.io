---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import SkillsMarquee from "../../components/SkillsMarquee.astro";
import TypedLede from "../../components/TypedLede.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog — Nicolas Barbosa"
  description="Notas sobre AI Engineer, Golang, Linux, Open Source, Engenharia de Software e liderança técnica."
  canonicalPath="/blog/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">Blog</h1>
      <TypedLede
        text="Notas sobre AI Engineer, Go, Linux, open source, engenharia de software e liderança técnica."
      />
    </section>

    <section class="section" aria-label="Blog posts">
      {
        posts.length === 0 ? (
          <p style="color: var(--muted); font-family: var(--mono);">
            No posts yet, check back soon.
          </p>
        ) : (
          <div class="post-list">
            {posts.map((post, index) => (
              <PostCard post={post} latest={index === 0} />
            ))}
          </div>
        )
      }
    </section>

    <SkillsMarquee />
  </main>
</Layout>
